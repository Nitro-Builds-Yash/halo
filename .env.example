# LLM & Search API Keys
OPENAI_API_KEY=your_openai_api_key_here
# Optional: DuckDuckGo is used if empty
TAVILY_API_KEY=your_tavily_api_key_here

# Models
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database & Retrieval
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=halo_documents
TOP_K_RETRIEVE=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Self-correction ceilings
MAX_REWRITES=1
MAX_REGENERATIONS=1

# Cross-encoder gatekeeper (scores normalised to 0..1)
GATE_HIGH=0.85
GATE_LOW=0.40

# Semantic cache
CACHE_ENABLED=true
CACHE_SIMILARITY=0.92
CACHE_TTL_SECONDS=86400
CACHE_MIN_CONFIDENCE=0.70

# Server
HOST=0.0.0.0
PORT=8000
# Set to require an X-API-Key header on /api/v1/*
API_KEY=
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
