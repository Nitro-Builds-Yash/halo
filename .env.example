# LLM & Search API Keys
OPENAI_API_KEY=your_openai_api_key_here
# Optional: DuckDuckGo is used if empty
TAVILY_API_KEY=your_tavily_api_key_here

# Models
# To run fully locally with Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=llama3.1,
# EMBEDDING_MODEL=nomic-embed-text (OPENAI_API_KEY can then be left empty)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-small
LLM_BASE_URL=
EMBEDDING_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Routing and fallback: a cheaper model for grading/planning/rewriting, and a backup model
# used when the main one errors or times out (FALLBACK_BASE_URL can point at e.g. local Ollama)
FAST_LLM_MODEL=
FALLBACK_LLM_MODEL=
FALLBACK_BASE_URL=

# Cost tracking: per-question limit in USD (0 = none); extra/override prices as JSON per 1M tokens
MAX_COST_PER_QUERY_USD=0
MODEL_PRICES=

# Prompt-injection guard for documents and web pages: sanitize | flag | off
INJECTION_GUARD=sanitize

# Agentic multi-hop search: auto (multi-part questions) | on | off
AGENTIC_SEARCH=auto
MAX_HOPS=2

# Vector Database & Retrieval
CHROMA_PERSIST_DIR=./chroma_db
# Set to use a Chroma server instead of local files (docker-compose does this)
CHROMA_HOST=
CHROMA_PORT=8000
COLLECTION_NAME=halo_documents
TOP_K_RETRIEVE=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONTEXT_CHARS=24000
MAX_DOC_CHARS=4000
# Where original uploads are kept so citations can link to them (default: <CHROMA_PERSIST_DIR>/files)
DOCUMENTS_DIR=

# Self-correction ceilings
MAX_REWRITES=1
MAX_REGENERATIONS=1

# Cross-encoder gatekeeper (scores normalised to 0..1)
GATE_HIGH=0.85
GATE_LOW=0.40

# Semantic cache
CACHE_ENABLED=true
CACHE_SIMILARITY=0.92
CACHE_TTL_SECONDS=86400
CACHE_MIN_CONFIDENCE=0.70

# Server
HOST=0.0.0.0
PORT=8000
# Set to require an X-API-Key header on /api/v1/*
API_KEY=
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# Optional: LangSmith tracing (every LLM call and graph step, with latency and tokens)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=halo
